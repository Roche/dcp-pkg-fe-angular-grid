{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "@open-dcp/angular-grid": {
      "projectType": "library",
      "root": "projects/open-dcp/angular-grid",
      "sourceRoot": "projects/open-dcp/angular-grid/src",
      "prefix": "odcp",
      "architect": {
        "build": {
          "builder": "@angular-devkit/build-angular:ng-packagr",
          "options": {
            "project": "projects/open-dcp/angular-grid/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/open-dcp/angular-grid/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/open-dcp/angular-grid/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-devkit/build-angular:karma",
          "options": {
            "tsConfig": "projects/open-dcp/angular-grid/tsconfig.spec.json",
            "polyfills": [
              "zone.js",
              "zone.js/testing"
            ]
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": "projects/open-dcp/angular-grid/.storybook",
            "browserTarget": "@open-dcp/angular-grid:build",
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "projects/open-dcp/angular-grid"
            ],
            "port": 6009,
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/open-dcp/angular-grid/src",
                "projects/open-dcp/angular-grid/node_modules/@open-dcp/styles",
                "node_modules/@open-dcp/styles",
                "node_modules/@open-dcp/angular-styles"
              ]
            },
            "styles": [
              "projects/open-dcp/angular-grid/src/styles.scss"
            ]
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": "projects/open-dcp/angular-grid/.storybook",
            "browserTarget": "@open-dcp/angular-grid:build",
            "compodoc": true,
            "compodocArgs": [
              "-e",
              "json",
              "-d",
              "projects/open-dcp/angular-grid"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "projects/open-dcp/angular-grid/src",
                "projects/open-dcp/angular-grid/node_modules/@open-dcp/styles",
                "node_modules/@open-dcp/styles",
                "node_modules/@open-dcp/angular-styles"
              ]
            },
            "styles": [
              "projects/open-dcp/angular-grid/src/styles.scss"
            ],
            "outputDir": "storybook-static"
          }
        }
      }
    }
  }
}
